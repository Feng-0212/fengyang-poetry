# ============================================================
# 墨韵阁 · 环境变量模板（提交到仓库供参考）
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略）
# ============================================================

# 写操作密码（必填，安全关键，勿用 NEXT_PUBLIC_* 前缀）
POEM_PASSWORD=

# Upstash Redis（任选一组命名，代码均兼容）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=

# AI 文本模型（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=

# AI 图像模型（可选，留空复用文本配置）
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=
# AI_IMAGE_MODEL_FALLBACK=

# 备份鉴权（生产建议配置）
CRON_SECRET=

# 异地容灾（可选）：每日备份时同步推送快照到外部端点（如自建服务器/对象存储接收器）
# 未配置则维持同库快照；推送失败不影响本地快照
# BACKUP_REMOTE_URL=
# BACKUP_REMOTE_TOKEN=

# 站点元信息
NEXT_PUBLIC_SITE_URL=

# TTS 运行时合成（仅自建部署可开）
# TTS_RUNTIME_SYNTH=1
